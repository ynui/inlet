# Inlet server config. Loaded automatically from ./.env (exported env wins).
# INLET_BIND=:8080
# INLET_CONTROL_ADDR=:8081

# Allow token creation without an invite. Leave false for invite-only.
# INLET_OPEN_SIGNUP=false

# Public base URL for clients (e.g. https://example.com or http://yourdomain:8080)
# INLET_PUBLIC_BASE=http://localhost:8080

# Token database (defaults to ./data/inlet.db in the working directory)
# INLET_DB=/data/inlet.db

# Token cleanup windows
# INLET_STALE_AFTER=720h
# INLET_OPEN_STALE_AFTER=168h
# INLET_REVOKED_RETENTION=168h
# INLET_INVITE_TTL=24h

# Optional bootstrap tokens, imported once when the database is empty.
# INLET_TOKENS=your-secret-token
