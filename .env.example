# Public URL advertised by inlet clients. For self-hosting, change this to your
# HTTPS hostname; otherwise the server derives it from the incoming request.
INLET_PUBLIC_BASE=https://inletd.onrender.com

# Invite-only is the default. Set true only if you want public self-signup.
INLET_OPEN_SIGNUP=false

# Optional public request logs (method, tunnel ID, status, duration; no paths or bodies).
# INLET_ACCESS_LOG=true

# Optional bootstrap secret for the `inlet admin` remote CLI. Generate a long random value.
# INLET_ADMIN_TOKEN=

# Optional GitHub OAuth app credentials. Enable Device Flow in the OAuth app settings.
# GitHub login and open signup can both be enabled at the same time.
# INLET_GITHUB_CLIENT_ID=
# INLET_GITHUB_CLIENT_SECRET=

# Optional host port; change if 8080 is already used. Container port stays 8080.
# INLET_HOST_PORT=9900

# Optional: enable a separate control/signup listener instead of sharing :8080.
# INLET_CONTROL_ADDR=:8081

# Optional cleanup and invite settings.
# INLET_STALE_AFTER=720h
# INLET_OPEN_STALE_AFTER=168h
# INLET_REVOKED_RETENTION=168h
# INLET_INVITE_TTL=24h

