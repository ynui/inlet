# Inlet server config. Loaded automatically from ./.env (exported env wins).
INLET_TOKENS=your-secret-token
# INLET_BIND=:8080
# INLET_CONTROL_ADDR=:8081
# comma separated for multiple tokens: INLET_TOKENS=token1,token2

# Public base URL for clients (e.g. https://example.com or http://yourdomain:8080)
# INLET_PUBLIC_BASE=http://localhost:8080
